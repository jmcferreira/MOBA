{
  "name": "moba-boardgame",
  "version": "0.1.0",
  "description": "Turn-based digital boardgame inspired by MOBAs",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "build:web": "esbuild src/web/main.ts --bundle --outfile=web/bundle.js --format=iife --target=es2020",
    "dev:web": "esbuild src/web/main.ts --bundle --outfile=web/bundle.js --format=iife --target=es2020 --servedir=web --serve=0.0.0.0:8080",
    "build:standalone": "npm run build:web && node scripts/build-standalone.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "esbuild": "^0.27.3",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
